# dependencies and build output
node_modules/
.next/
dist/
out/
# test coverage reports; anchored, because the site has source folders named "coverage"
/coverage/
/apps/web/coverage/

# secrets: keys live only in .env.local and in the hosting provider's env
.env
.env.*
!.env.example

# local caches
.cache/
.turbo/
.vercel/

# OS and editor files
.DS_Store
.idea/
.vscode/

# archives and large downloads: PSI documents are downloaded by the pipeline, not committed.
# data/raw keeps only the 22 experimental tables and the metadata JSON.
*.zip
data/raw/**
!data/raw/**/
!data/raw/*/metadata.json
!data/raw/*/Experimental table/*.csv
data/extracted/

# BMAD: personal install answers stay local; team config is committed
_bmad/config.user.toml
_bmad/custom/*.user.toml

# python
.venv/
__pycache__/
*.pyc
*.part
