{
  "tableFile": "PSI-159_Experimental table_CFI-G_Inverse Flames.csv",
  "investigationId": "PSI-159",
  "tableId": "CFI-G-Inverse",
  "mappingVersion": "1.0.0",
  "granularity": "test",
  "comment": "861 fully blank rows in the source CSV are dropped by the reader; sourceRow keeps the original numbering.",
  "label": {
    "column": "Test"
  },
  "fuel": {
    "column": "Fuel",
    "parser": "gas",
    "geometry": "burner"
  },
  "fields": {
    "pressureKpa": {
      "column": "approx p (bar)",
      "unit": "bar"
    },
    "burnTimeS": {
      "column": "burn time (sec)",
      "unit": "s"
    }
  },
  "outcome": {
    "column": "Self -ext or flow term",
    "map": {
      "se": "self-extinguished",
      "ft": "flow-terminated"
    }
  },
  "ignited": {
    "rule": "map",
    "column": "Hot ignition",
    "map": {
      "yes": true,
      "no": false,
      "flash": true
    }
  },
  "overrides": [
    {
      "column": "Comments",
      "regex": "(?i)fail(ed)? to ignite|not ignited",
      "set": {
        "ignited": false,
        "outcome": "not-ignited"
      }
    },
    {
      "column": "Hot ignition",
      "regex": "(?i)^flash$",
      "set": {},
      "note": "Hot ignition recorded as 'flash'."
    }
  ],
  "notes": {
    "templates": [
      "Burner oxidizer O2 mole fraction {XO2}; ambient fuel mole fraction {Xf  before test} before the test.",
      "Flame color: {Color}.",
      "Comments: {Comments}."
    ],
    "static": [
      "Inverse flame: oxygen issues from the burner into a fuel/diluent ambient, so the ambient O2 fields are null.",
      "Pressure is given in the source as approximate."
    ]
  },
  "gravity": {
    "value": "micro",
    "source": "ISS flight experiment"
  }
}
