{
  "tableFile": "PSI-98_Experimental table_SAFFIRE-1.csv",
  "investigationId": "PSI-98",
  "tableId": "SAFFIRE-1",
  "mappingVersion": "1.1.0",
  "granularity": "test",
  "label": {
    "column": "Sample Number "
  },
  "join": {
    "root": "derived",
    "file": "PSI-98_telemetry.csv",
    "label": "the Saffire-I sensor telemetry (PSI-98 Raw Data, 'Sample N Sensor Data Complete TM graphs.xlsx', sheet 'Calibrated Data', column 'Ambient Pressure' in PSIA; median of all readings in the sample's file, summarised in data/derived/PSI-98_telemetry.csv)",
    "shortLabel": "the Saffire-I sensor telemetry",
    "headerRow": 1,
    "key": {
      "table": [
        "Sample Number "
      ],
      "source": [
        "test"
      ]
    },
    "confidence": "high"
  },
  "skipRows": [
    {
      "column": "Material",
      "regex": "(?i)flow visulation",
      "reason": "pre-test flow visualization video, not a burn"
    }
  ],
  "fuel": {
    "column": "Material",
    "parser": "plain",
    "state": "solid"
  },
  "fields": {
    "thicknessMm": {
      "column": "Sample Thickness (cm)",
      "unit": "cm"
    },
    "widthMm": {
      "column": "Sample Width (cm)",
      "unit": "cm"
    },
    "flowCmS": {
      "column": "Air Flow (cm/s)",
      "unit": "cm/s"
    },
    "o2Pct": {
      "column": "Percent O2",
      "unit": "%"
    },
    "burnTimeS": {
      "column": "Burn Time (s)",
      "unit": "s"
    },
    "pressureKpa": {
      "column": "@pressure psia median",
      "unit": "psi"
    }
  },
  "flowDirection": {
    "column": "Flow Direction ",
    "map": {
      "concurrent": "concurrent",
      "opposed": "opposed"
    }
  },
  "ignited": {
    "rule": "burnTime"
  },
  "notes": {
    "templates": [
      "Sample length {Sample Length (cm)} cm.",
      "Ignition power {Ignition Power (W)} W for {Ignition Time (s)} s."
    ]
  },
  "gravity": {
    "value": "micro",
    "source": "ISS flight experiment"
  }
}
