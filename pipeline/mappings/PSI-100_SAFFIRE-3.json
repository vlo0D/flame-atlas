    "state": "solid"
  },
  "fields": {
    "thicknessMm": {
      "column": "Sample Thickness",
      "unit": "cm"
    },
    "widthMm": {
      "column": "Sample Width",
      "unit": "cm"
    },
    "flowCmS": {
      "column": "Air Flow ",
      "unit": "cm/s"
    },
    "pressureKpa": {
      "column": "@pressure psia median",
      "unit": "psi"
    },
    "o2Pct": {
      "column": "@oxygen pct median",
      "unit": "%",
      "approx": true
    }
  },
  "flowDirection": {
    "column": "Direction",
    "map": {
      "concurrent": "concurrent",
      "opposed": "opposed"
    }
  },
  "notes": {
    "templates": [
      "Sample length {Sample Length}."
    ],
    "static": [
      "Oxygen concentration and burn results are not in the source table. Oxygen is the reading of the experiment's own O2 sensor; in Saffire-I the same kind of sensor read about 0.7 points above the oxygen its table reports, so the value is marked approximate."
