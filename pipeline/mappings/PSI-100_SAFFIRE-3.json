{
  "tableFile": "PSI-100_Experimental table_SAFFIRE-3.csv",
  "investigationId": "PSI-100",
  "tableId": "SAFFIRE-3",
  "mappingVersion": "1.1.0",
  "granularity": "test",
  "label": {
    "column": "Sample Number "
  },
  "join": {
