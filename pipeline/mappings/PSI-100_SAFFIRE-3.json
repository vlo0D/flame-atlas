    "label": "the Saffire-III sensor telemetry (PSI-100 Raw Data, 'Saffire III Sample N Sensors.xlsx', sheet 'Calibrated Data', columns 'Ambient Pressure' in PSIA and 'O2' in percent; median of all readings in the sample's file, summarised in data/derived/PSI-100_telemetry.csv)",
    "shortLabel": "the Saffire-III sensor telemetry",
    "headerRow": 1,
    "key": {
      "table": [
        "Sample Number "
      ],
      "source": [
        "test"
      ]
    },
    "confidence": "medium"
  },
  "fuel": {
    "column": "Material",
